{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reusable-data-analysis/datasets",
  "title": "指标数据集",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "datasets", "execution_log", "blocking_issues", "next_node"],
  "properties": {
    "status": { "enum": ["ready", "blocked"] },
    "datasets": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "grain", "columns", "rows", "metric_definitions", "lineage", "attribution", "calculation_warnings"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "grain": { "type": "string", "minLength": 1 },
          "columns": { "type": "array", "minItems": 1, "items": { "type": "string" } },
          "rows": { "type": "array", "items": { "type": "object" } },
          "metric_definitions": { "type": "array", "items": { "type": "object" } },
          "lineage": { "type": "object" },
          "attribution": {
            "type": "array",
            "description": "归因/贡献度拆解：按基准期与报告期，拆出每个分组对总量变化的贡献度并排序，用于定位而不只是列涨跌。",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "required": ["metric", "group_dimension", "baseline", "target", "items"],
              "properties": {
                "metric": { "type": "string", "minLength": 1 },
                "group_dimension": { "type": "string", "minLength": 1 },
                "baseline": { "type": "string" },
                "target": { "type": "string" },
                "total_change": { "type": ["number", "null"], "description": "报告期合计减基准期合计；无法计算时为 null。" },
                "items": {
                  "type": "array",
                  "description": "按贡献度绝对值从大到小排序的分组明细。",
                  "items": {
                    "type": "object",
                    "additionalProperties": false,
                    "required": ["group", "baseline_value", "target_value", "delta", "contribution_rate"],
                    "properties": {
                      "group": { "type": "string" },
                      "baseline_value": { "type": "number" },
                      "target_value": { "type": "number" },
                      "delta": { "type": "number", "description": "该分组报告期减基准期。" },
                      "contribution_rate": { "type": ["number", "null"], "description": "该分组 delta 占总量变化的比例；总量变化为 0 时为 null。" }
                    }
                  }
                }
              }
            }
          },
          "calculation_warnings": { "type": "array", "items": { "type": "string" } }
        }
      }
    },
    "execution_log": { "type": "array", "items": { "type": "object" } },
    "blocking_issues": { "type": "array", "items": { "type": "string" } },
    "next_node": { "enum": ["data_validation", "preparation"] }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "ready" } } },
    "then": { "properties": { "datasets": { "minItems": 1 }, "blocking_issues": { "maxItems": 0 }, "next_node": { "const": "data_validation" } } },
    "else": { "properties": { "blocking_issues": { "minItems": 1 }, "next_node": { "const": "preparation" } } }
  }]
}
