{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "reusable-data-analysis/synthesis",
  "title": "全局洞察与设计决策",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "headline", "global_insights", "selected_chart_ids", "design_decisions", "issues", "next_node"],
  "properties": {
    "status": { "enum": ["ready", "blocked"] },
    "headline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["text", "evidence_refs"],
      "properties": {
        "text": { "type": "string", "minLength": 1, "description": "L1 结论页的一句话结论：什么指标、从多少变到多少、幅度、时间窗。" },
        "evidence_refs": { "type": "array", "minItems": 1, "items": { "type": "string" } }
      }
    },
    "global_insights": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["id", "phenomenon", "localization", "explanation", "action", "evidence_refs", "confidence"],
        "properties": {
          "id": { "type": "string", "minLength": 1 },
          "phenomenon": { "type": "string", "minLength": 1, "description": "现象：什么指标、从多少变到多少、幅度、时间窗。" },
          "localization": { "type": "string", "minLength": 1, "description": "定位：哪个维度/环节贡献最大，给出贡献度排序，而不是只列涨跌。" },
          "explanation": { "type": "string", "minLength": 1, "description": "解释：机制上说得通的假设，显式标注「已验证」或「待验证」。" },
          "action": {
            "type": "object",
            "additionalProperties": false,
            "required": ["owner", "timing", "what", "expected_impact", "verification"],
            "properties": {
              "owner": { "type": "string", "minLength": 1, "description": "谁负责。" },
              "timing": { "type": "string", "minLength": 1, "description": "什么时间。" },
              "what": { "type": "string", "minLength": 1, "description": "做什么。" },
              "expected_impact": { "type": "string", "minLength": 1, "description": "预期影响量级。" },
              "verification": { "type": "string", "minLength": 1, "description": "怎么验证。" }
            }
          },
          "evidence_refs": { "type": "array", "minItems": 2, "items": { "type": "string" } },
          "confidence": { "enum": ["high", "medium", "low"] }
        }
      }
    },
    "selected_chart_ids": { "type": "array", "items": { "type": "string" } },
    "design_decisions": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["chart_id", "decision", "reason"],
        "properties": {
          "chart_id": { "type": "string", "minLength": 1 },
          "decision": { "enum": ["keep", "remove"] },
          "reason": { "type": "string", "minLength": 1 }
        }
      }
    },
    "issues": { "type": "array", "items": { "type": "object" } },
    "next_node": { "enum": ["reporting", "local_insight", "data_validation"] }
  },
  "allOf": [{
    "if": { "properties": { "status": { "const": "ready" } } },
    "then": { "properties": { "global_insights": { "minItems": 1 }, "next_node": { "const": "reporting" } } },
    "else": { "properties": { "issues": { "minItems": 1 }, "next_node": { "enum": ["local_insight", "data_validation"] } } }
  }]
}
